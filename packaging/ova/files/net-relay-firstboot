#!/usr/bin/env bash
set -euo pipefail

FLAG="/var/lib/net-relay/firstboot.done"
INSTALLER_DIR="/opt/netbird-relay-installer"
BIN_PATH="/usr/local/bin/netbird-relay"
ROOT_RESIZE="/usr/local/sbin/setup-root-resize"
NETWORK_CHECK="/usr/local/sbin/setup-network-check"
ZRAM_SETUP="/usr/local/sbin/setup-zram"
KERNEL_TUNING="/usr/local/sbin/setup-kernel-tuning"

fail() {
  echo "错误：$*" >&2
  exit 1
}

check_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "缺少必需命令：$1"
}

check_disk_space() {
  local available_mb
  available_mb="$(df -Pm / | awk 'NR == 2 {print $4}')"
  [[ "$available_mb" =~ ^[0-9]+$ ]] || fail "无法检查 / 的可用空间"
  (( available_mb >= 256 )) || fail "/ 至少需要 256 MB 可用空间，当前为 ${available_mb} MB"
}

run_preflight_checks() {
  echo "正在执行 OVA 启动预检..."
  echo "[1/5] 环境预检：检查安装器、二进制文件和基础命令..."
  [[ -d "$INSTALLER_DIR" ]] || fail "未找到安装器目录：${INSTALLER_DIR}"
  [[ -x "$BIN_PATH" ]] || fail "未找到 netbird-relay 二进制文件：${BIN_PATH}"
  [[ -x "$ROOT_RESIZE" ]] || fail "未找到根分区扩容脚本：${ROOT_RESIZE}"
  [[ -x "$NETWORK_CHECK" ]] || fail "未找到网络自检脚本：${NETWORK_CHECK}"
  [[ -x "$ZRAM_SETUP" ]] || fail "未找到 ZRAM 脚本：${ZRAM_SETUP}"
  [[ -x "$KERNEL_TUNING" ]] || fail "未找到内核调优脚本：${KERNEL_TUNING}"
  check_cmd bash
  check_cmd curl
  check_cmd openssl
  check_disk_space
  echo "预检完成。"
  echo "[1/5] 环境预检完成。"
}

if [[ -f "$FLAG" ]]; then
  exit 0
fi

clear || true
cat <<'EOF'
=================================================
          NetBird Relay OVA 首次启动向导
=================================================

默认登录信息：
- 用户：root
- SSH 端口：__SSH_PORT__

首次启动步骤：
1. 环境预检
2. 根分区扩容
3. 网络自检
4. ZRAM 和内核调优
5. Relay 配置向导

提示：
- 配置完成后可再次运行 rels 打开管理菜单。
- 多节点 Relay 组必须复用同一个密钥。
=================================================
EOF

run_preflight_checks
echo "[2/5] 根分区扩容：尝试扩展磁盘分区和文件系统..."
"$ROOT_RESIZE" || echo "警告：根分区扩容失败，将继续 Relay 配置。"
echo "[2/5] 根分区扩容完成。"

echo "[3/5] 网络自检：加载常见虚拟网卡模块并检查 DHCP..."
"$NETWORK_CHECK" || echo "警告：网络自检失败，将继续 Relay 配置。"
echo "[3/5] 网络自检完成。"

echo "[4/5] ZRAM 和内核调优：启用压缩交换、维护任务和保守的 sysctl 配置..."
"$ZRAM_SETUP" || echo "警告：ZRAM 初始化失败，将继续 Relay 配置。"
"$KERNEL_TUNING" || echo "警告：内核调优失败，将继续 Relay 配置。"
echo "[4/5] ZRAM 和内核调优完成。"

cd "$INSTALLER_DIR"
echo "[5/5] Relay 配置向导：正在启动 NetBird Relay 配置。"
bash ./setup-relay.sh

mkdir -p "$(dirname "$FLAG")"
touch "$FLAG"
echo "首次启动配置完成。再次运行 rels 可打开管理菜单。"
