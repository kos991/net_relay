#!/usr/bin/env bash
set -euo pipefail

log() {
  echo "网络自检：$*"
}

if [[ "$(id -u)" -ne 0 ]]; then
  echo "错误：请使用 root 运行" >&2
  exit 1
fi

MODULES=(
  virtio_pci
  virtio_blk
  virtio_scsi
  virtio_net
  virtio_balloon
  virtio_console
  e1000
  e1000e
  vmxnet3
  xen_netfront
  ena
  hv_netvsc
  gve
)

persist_modules() {
  mkdir -p /etc/modules-load.d
  printf '%s\n' "${MODULES[@]}" > /etc/modules-load.d/net-relay-network.conf

  touch /etc/modules
  for module in "${MODULES[@]}"; do
    grep -qxF "$module" /etc/modules || echo "$module" >> /etc/modules
  done
}

load_modules() {
  local module
  for module in "${MODULES[@]}"; do
    modprobe "$module" 2>/dev/null || true
  done
}

detect_interfaces() {
  ip -o link show 2>/dev/null \
    | awk -F': ' '$2 != "lo" {print $2}' \
    | cut -d@ -f1
}

try_dhcp() {
  local iface="$1"
  ip link set "$iface" up 2>/dev/null || true

  if command -v udhcpc >/dev/null 2>&1; then
    udhcpc -q -n -i "$iface" -t 3 -T 3 >/dev/null 2>&1 || true
  elif command -v dhclient >/dev/null 2>&1; then
    dhclient -1 "$iface" >/dev/null 2>&1 || true
  fi
}

persist_modules
load_modules

if ! command -v ip >/dev/null 2>&1; then
  log "跳过 DHCP 检查：未找到 ip 命令"
  exit 0
fi

mapfile -t interfaces < <(detect_interfaces)
if [[ "${#interfaces[@]}" -eq 0 ]]; then
  log "警告：未检测到非回环网络接口"
  exit 0
fi

if ip route | grep -q '^default '; then
  log "默认路由已存在"
  ip -br addr || true
  exit 0
fi

for iface in "${interfaces[@]}"; do
  log "正在通过 ${iface} 请求 DHCP 租约"
  try_dhcp "$iface"
  if ip route | grep -q '^default '; then
    log "已通过 ${iface} 获取默认路由"
    ip -br addr || true
    exit 0
  fi
done

log "警告：DHCP 未提供默认路由"
ip -br addr || true
ip route || true
