    nb_status_hdr) printf '%s' "=== NetBird Relay Status ===" ;;
    alma_status_hdr) printf '%s' "=== Alma Relay Status ===" ;;
    log_target_prompt) printf '%s' "Log target: 1) NetBird Relay  2) Alma Relay [1]: " ;;
    no_backup) printf 'No previous binary backup found (%s).' "$1" ;;
    rolling_back) printf '%s' "Rolling back to previous netbird-relay binary..." ;;
    rollback_done) printf '%s' "Rollback completed and service restarted." ;;
    restarted) printf '%s' "Services restarted." ;;
    cert_title) printf '%s' "==================== Certificate Status ====================" ;;
    cert_file) printf 'Relay certificate file: %s' "$1" ;;
    key_file) printf 'Relay private key file: %s' "$1" ;;
    cert_from) printf 'Certificate valid from: %s' "$1" ;;
    cert_until) printf 'Certificate valid until: %s' "$1" ;;
    cert_days) printf 'Remaining days: %s' "$1" ;;
    cert_soon) printf 'Expires within 30 days: %s' "$1" ;;
    cert_renewal) printf 'Certificate renewal: %s' "$1" ;;
    yes) printf '%s' "yes" ;;
    no) printf '%s' "no" ;;
    unknown) printf '%s' "unknown" ;;
    acme_none) printf '%s' "acme.sh not detected" ;;
    acme_cron_ok) printf '%s' "acme.sh cron renewal is configured" ;;
    acme_cron_missing) printf '%s' "acme.sh is installed, but cron renewal was not detected" ;;
    sys_title) printf '%s' "==================== System Optimization Status ====================" ;;
    zram_none) printf '%s' "zramctl output was not detected" ;;
    swap_none) printf '%s' "swap output was not detected" ;;
    menu_title) printf '%s' "NetBird & Alma Relay Management Menu" ;;
    m1) printf '%s' "1) Install or reconfigure Relay (NetBird + Alma)" ;;
    m2) printf '%s' "2) Update Relay binary (keeps config)" ;;
    m3) printf '%s' "3) Update management scripts (rels/install/setup)" ;;
    m4) printf '%s' "4) Show service status (NetBird + Alma)" ;;
    m5) printf '%s' "5) Show service logs (NetBird / Alma)" ;;
    m6) printf '%s' "6) Restart Relay service (NetBird + Alma)" ;;
    m7) printf '%s' "7) Manage Alma Relay (config / start-stop / URL)" ;;
