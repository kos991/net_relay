rollback_netbird_binary() {
  local bak_path="${BIN_PATH}.bak"
  if [[ ! -f "$bak_path" ]]; then
    echo "$(msg no_backup "$bak_path")"
    return 1
  fi
  echo "$(msg rolling_back)"
  cp -f "$bak_path" "$BIN_PATH"
  chmod 0755 "$BIN_PATH"
  start_restart_netbird >/dev/null
  echo "$(msg rollback_done)"
}

