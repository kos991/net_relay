      m6) printf '%s' "6) 重启服务（NetBird + Alma）" ;;
      m7) printf '%s' "7) Alma Relay 管理（配置 / 启停 / 访问地址）" ;;
      m8) printf '%s' "8) 查看 TLS 证书状态" ;;
