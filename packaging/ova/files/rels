fail() {
  echo "$(msg err_prefix "$*")" >&2
  exit 1
}

require_installer_dir() {
  [[ -d "$INSTALLER_DIR" ]] || fail "$(msg missing_installer_dir "$INSTALLER_DIR")"
}

read_env_value() {
  local file="$1"
  local key="$2"
  [[ -r "$file" ]] || return 0
  awk -F= -v k="$key" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$file" 2>/dev/null || true
}

load_env_file() {
  if [[ -f "$ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
  fi
}

has_netbird_service() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl list-unit-files netbird-relay.service 2>/dev/null | grep -q 'netbird-relay.service' && return 0
    [[ -f /etc/systemd/system/netbird-relay.service ]] && return 0
  elif [[ -x /etc/init.d/netbird-relay ]]; then
    return 0
  fi
  return 1
}

is_netbird_running() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl is-active --quiet netbird-relay 2>/dev/null
  elif command -v service >/dev/null 2>&1; then
    service netbird-relay status >/dev/null 2>&1
  else
    return 1
  fi
}

has_alma_service() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl list-unit-files alma-relay.service 2>/dev/null | grep -q 'alma-relay.service' && return 0
    [[ -f /etc/systemd/system/alma-relay.service ]] && return 0
  elif [[ -x /etc/init.d/alma-relay ]]; then
    return 0
  fi
  return 1
}

is_alma_running() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl is-active --quiet alma-relay 2>/dev/null
  elif command -v service >/dev/null 2>&1; then
    service alma-relay status >/dev/null 2>&1
  else
    return 1
  fi
}

get_relay_exposed() {
  read_env_value "$ENV_FILE" "NB_EXPOSED_ADDRESS"
}

get_relay_domain() {
  local exposed
  exposed="$(get_relay_exposed)"
  exposed="${exposed#rels://}"
  exposed="${exposed#rel://}"
  printf '%s' "${exposed%%:*}"
}

get_relay_port() {
  local listen
  listen="$(read_env_value "$ENV_FILE" "NB_LISTEN_ADDRESS")"
  printf '%s' "${listen##*:}"
}

get_stun_port() {
  local stun
  stun="$(read_env_value "$ENV_FILE" "NB_STUN_PORTS")"
  printf '%s' "${stun%%,*}"
}

get_netbird_state_label() {
  if is_netbird_running; then
    msg state_running
  elif has_netbird_service || [[ -x "$BIN_PATH" ]]; then
    msg state_stopped
  else
    msg state_not_installed
  fi
}

get_alma_state_label() {
  if is_alma_running; then
    msg state_running
  elif has_alma_service && [[ -f "$ALMA_ENV_FILE" ]]; then
    msg state_stopped
  else
    msg state_not_installed
  fi
}

get_netbird_version() {
  local ver=""
  if [[ -r "$BIN_PATH" ]]; then
    if command -v strings >/dev/null 2>&1; then
      ver="$({ strings "$BIN_PATH" 2>/dev/null || true; } | grep -Fm1 $'github.com/netbirdio/netbird\tv' | awk '{print $3}' || true)"
    fi
    if [[ -z "$ver" ]]; then
      ver="$(LC_ALL=C grep -aFm1 $'github.com/netbirdio/netbird\tv' "$BIN_PATH" 2>/dev/null | sed -n 's/.*github\.com\/netbirdio\/netbird[[:space:]]*\(v[0-9][0-9.]*[^[:space:]]*\).*/\1/p' | head -n 1 || true)"
    fi
  fi
  if [[ -z "$ver" && -r "$NB_VERSION_FILE" ]]; then
    ver="$(read_env_value "$NB_VERSION_FILE" "NETBIRD_RELAY_REF")"
  fi
  printf '%s' "${ver:--}"
}

get_alma_version() {
  local ver=""
  if [[ -r "$ALMA_RELAY_PATH" ]]; then
    ver="$(sed -n 's/.*VERSION = "\([^"]*\)".*/\1/p' "$ALMA_RELAY_PATH" 2>/dev/null | head -n 1 || true)"
  fi
  if [[ -n "$ver" && "$ver" != v* ]]; then
    ver="v${ver}"
  fi
  printf '%s' "${ver:--}"
}

get_alma_url_label() {
  local port domain
  port="$(read_env_value "$ALMA_ENV_FILE" "PORT")"
  if [[ -z "$port" ]]; then
    printf '%s' "-"
    return 0
  fi
  domain="$(get_relay_domain)"
  if [[ -n "$domain" ]]; then
    printf 'https://%s:%s' "$domain" "$port"
  else
    printf 'https://<domain>:%s' "$port"
  fi
}

follow_service_logs() {
  local target="$1"
  if command -v journalctl >/dev/null 2>&1; then
    journalctl -u "$target" -f -n 120
  else
    tail -f "/var/log/${target}.log" "/var/log/${target}.err"
  fi
}

show_service_status() {
  local target="$1"
  local header="$2"
  echo "$header"
  if command -v systemctl >/dev/null 2>&1; then
    systemctl status "$target" --no-pager || true
  elif command -v service >/dev/null 2>&1; then
    service "$target" status || true
  else
    fail "$(msg no_service_mgr)"
  fi
}

run_install() {
  require_installer_dir
  cd "$INSTALLER_DIR"
  RELS_LANG="$RELS_LANG" bash ./setup-relay.sh
}

update_netbird_binary() {
  require_installer_dir
  cd "$INSTALLER_DIR"
  echo "$(msg updating_netbird)"
  RELS_LANG="$RELS_LANG" bash ./install.sh --update-netbird
}

update_alma_binary() {
  require_installer_dir
  cd "$INSTALLER_DIR"
  echo "$(msg updating_alma)"
  RELS_LANG="$RELS_LANG" bash ./install.sh --update-alma
}

update_scripts() {
  require_installer_dir
  cd "$INSTALLER_DIR"
  echo "$(msg updating_scripts)"
  RELS_LANG="$RELS_LANG" FORCE_UPDATE_SCRIPTS=1 bash ./install.sh --scripts-only
}

reload_self() {
  local self_bin="${BASH_SOURCE[0]:-$0}"
  if [[ ! -r "$self_bin" ]]; then
    self_bin="$(command -v rels 2>/dev/null || printf '/usr/local/sbin/rels')"
  fi
  echo "$(msg reloading_rels)"
  if [[ -x "$self_bin" ]]; then
    exec env -u RELS_VERSION RELS_LANG="$RELS_LANG" "$self_bin" "$@"
  elif [[ -r "$self_bin" ]]; then
    exec env -u RELS_VERSION RELS_LANG="$RELS_LANG" bash "$self_bin" "$@"
  fi
}

start_restart_netbird() {
  if ! has_netbird_service; then
