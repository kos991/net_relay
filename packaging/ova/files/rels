      cert_renewal) printf '自动续期状态：%s' "$1" ;;
      yes) printf '%s' "是" ;;
      no) printf '%s' "否" ;;
      unknown) printf '%s' "未知" ;;
      acme_none) printf '%s' "未检测到 acme.sh" ;;
      acme_cron_ok) printf '%s' "已配置 acme.sh 定时续期" ;;
