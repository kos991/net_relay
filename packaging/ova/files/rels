  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable netbird-relay >/dev/null 2>&1 || true
    systemctl restart netbird-relay
  elif command -v service >/dev/null 2>&1; then
    rc-update add netbird-relay default >/dev/null 2>&1 || true
    service netbird-relay restart
  else
    fail "$(msg no_service_mgr)"
  fi
  echo "$(msg nb_started)"
}

stop_netbird() {
  if ! has_netbird_service; then
    echo "$(msg nb_not_installed_hint)"
    return 1
  fi
  if command -v systemctl >/dev/null 2>&1; then
    systemctl stop netbird-relay || true
  elif command -v service >/dev/null 2>&1; then
    service netbird-relay stop || true
  else
    fail "$(msg no_service_mgr)"
