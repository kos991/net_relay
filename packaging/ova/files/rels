#!/usr/bin/env bash
set -euo pipefail

INSTALLER_DIR="${INSTALLER_DIR:-/opt/netbird-relay-installer}"
ENV_FILE="${ENV_FILE:-/etc/netbird-relay/relay.env}"
ALMA_ENV_FILE="${ALMA_ENV_FILE:-/etc/alma-relay/relay.env}"
LANG_FILE="${LANG_FILE:-/etc/netbird-relay/lang}"
BIN_PATH="${BIN_PATH:-/usr/local/bin/netbird-relay}"
RELS_LANG="${RELS_LANG:-}"

init_language() {
  if [[ "$RELS_LANG" == "zh" || "$RELS_LANG" == "en" ]]; then
    return 0
  fi
  if [[ -r "$LANG_FILE" ]]; then
    local saved=""
    saved="$(tr -d '[:space:]' < "$LANG_FILE" 2>/dev/null || true)"
    if [[ "$saved" == "zh" || "$saved" == "en" ]]; then
      RELS_LANG="$saved"
      return 0
    fi
  fi
  RELS_LANG="zh"
}

is_zh() {
  [[ "${RELS_LANG:-zh}" == "zh" ]]
}

save_language() {
  local lang="$1"
  local dir
  dir="$(dirname "$LANG_FILE")"
  if [[ -d "$dir" && -w "$dir" ]]; then
    printf '%s\n' "$lang" > "$LANG_FILE" 2>/dev/null || true
  fi
}

toggle_language() {
  if is_zh; then
    RELS_LANG="en"
  else
    RELS_LANG="zh"
  fi
  save_language "$RELS_LANG"
}

msg() {
  local key="$1"
  shift || true
  if is_zh; then
    case "$key" in
      err_prefix) printf '错误：%s' "$1" ;;
      missing_installer_dir) printf '未找到安装目录：%s' "$1" ;;
      updating_binary) printf '%s' "正在下载并更新最新 NetBird Relay 程序..." ;;
      updating_scripts) printf '%s' "正在下载并更新最新管理脚本..." ;;
      no_service_mgr) printf '%s' "未检测到 systemd 或 OpenRC。" ;;
      nb_status_hdr) printf '%s' "=== NetBird Relay 状态 ===" ;;
      alma_status_hdr) printf '%s' "=== Alma Relay 状态 ===" ;;
      log_target_prompt) printf '%s' "请选择日志目标：1) NetBird Relay  2) Alma Relay [1]：" ;;
      no_backup) printf '未找到上一版本备份（%s）。' "$1" ;;
      rolling_back) printf '%s' "正在回滚到上一版本 NetBird Relay..." ;;
      rollback_done) printf '%s' "回滚完成并已重启服务。" ;;
