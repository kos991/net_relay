ALMA_RELAY_PATH="${ALMA_RELAY_PATH:-/usr/local/lib/alma-relay/alma-relay.cjs}"
RELS_LANG="${RELS_LANG:-}"

init_language() {
  if [[ "$RELS_LANG" == "zh" || "$RELS_LANG" == "en" ]]; then
    return 0
  fi
  if [[ -r "$LANG_FILE" ]]; then
    local saved=""
    saved="$(tr -d '[:space:]' < "$LANG_FILE" 2>/dev/null || true)"
    if [[ "$saved" == "zh" || "$saved" == "en" ]]; then
      RELS_LANG="$saved"
      return 0
    fi
  fi
  RELS_LANG="zh"
}

is_zh() {
  [[ "${RELS_LANG:-zh}" == "zh" ]]
}

save_language() {
  local lang="$1"
  local dir
  dir="$(dirname "$LANG_FILE")"
  if [[ -d "$dir" && -w "$dir" ]]; then
    printf '%s\n' "$lang" > "$LANG_FILE" 2>/dev/null || true
  fi
}

toggle_language() {
  if is_zh; then
    RELS_LANG="en"
  else
    RELS_LANG="zh"
  fi
  save_language "$RELS_LANG"
}

