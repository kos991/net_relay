fail() {
  echo "$(msg err_prefix "$*")" >&2
  exit 1
}

require_installer_dir() {
  [[ -d "$INSTALLER_DIR" ]] || fail "$(msg missing_installer_dir "$INSTALLER_DIR")"
}

run_install() {
  require_installer_dir
  cd "$INSTALLER_DIR"
  RELS_LANG="$RELS_LANG" bash ./setup-relay.sh
}

update_binary() {
  require_installer_dir
  cd "$INSTALLER_DIR"
  echo "$(msg updating_binary)"
  RELS_LANG="$RELS_LANG" bash ./install.sh
}

update_scripts() {
  require_installer_dir
  cd "$INSTALLER_DIR"
  echo "$(msg updating_scripts)"
  RELS_LANG="$RELS_LANG" FORCE_UPDATE_SCRIPTS=1 bash ./install.sh --scripts-only
}

has_alma_service() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl list-unit-files alma-relay.service 2>/dev/null | grep -q 'alma-relay.service' && return 0
    [[ -f /etc/systemd/system/alma-relay.service ]] && return 0
  elif [[ -x /etc/init.d/alma-relay ]]; then
    return 0
  fi
  return 1
}

is_alma_running() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl is-active --quiet alma-relay 2>/dev/null
  elif command -v service >/dev/null 2>&1; then
    service alma-relay status >/dev/null 2>&1
  else
    return 1
  fi
}

show_status() {
  echo "$(msg nb_status_hdr)"
  if command -v systemctl >/dev/null 2>&1; then
    systemctl status netbird-relay --no-pager || true
    if has_alma_service; then
      echo
      echo "$(msg alma_status_hdr)"
      systemctl status alma-relay --no-pager || true
    fi
  elif command -v service >/dev/null 2>&1; then
    service netbird-relay status || true
    if has_alma_service; then
      echo
      echo "$(msg alma_status_hdr)"
      service alma-relay status || true
    fi
  else
    fail "$(msg no_service_mgr)"
  fi
}

follow_service_logs() {
  local target="$1"
  if command -v journalctl >/dev/null 2>&1; then
    journalctl -u "$target" -f -n 120
  else
    tail -f "/var/log/${target}.log" "/var/log/${target}.err"
  fi
}

show_logs() {
  local target="netbird-relay"
  if has_alma_service; then
    printf '%s' "$(msg log_target_prompt)"
    local log_choice=""
    IFS= read -r log_choice || log_choice=""
    if [[ "$log_choice" == "2" ]]; then
      target="alma-relay"
    fi
  fi
  follow_service_logs "$target"
}

restart_service() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl restart netbird-relay
    if systemctl is-active --quiet alma-relay 2>/dev/null; then
      systemctl restart alma-relay
    fi
  elif command -v service >/dev/null 2>&1; then
    service netbird-relay restart
    if service alma-relay status >/dev/null 2>&1; then
      service alma-relay restart
    fi
  else
    fail "$(msg no_service_mgr)"
  fi
  echo "$(msg restarted)"
}

rollback_binary() {
  local bak_path="/usr/local/bin/netbird-relay.bak"
  if [[ ! -f "$bak_path" ]]; then
    echo "$(msg no_backup "$bak_path")"
    return 1
  fi
  echo "$(msg rolling_back)"
  cp -f "$bak_path" "$BIN_PATH"
  chmod 0755 "$BIN_PATH"
  restart_service
  echo "$(msg rollback_done)"
}

load_env_file() {
  if [[ -f "$ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
  fi
}

read_env_value() {
  local file="$1"
  local key="$2"
  [[ -r "$file" ]] || return 0
  awk -F= -v k="$key" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$file" 2>/dev/null || true
}

get_relay_domain() {
  local exposed
  exposed="$(read_env_value "$ENV_FILE" "NB_EXPOSED_ADDRESS")"
  exposed="${exposed#rels://}"
  exposed="${exposed#rel://}"
  printf '%s' "${exposed%%:*}"
}

get_relay_port() {
  local listen
  listen="$(read_env_value "$ENV_FILE" "NB_LISTEN_ADDRESS")"
  printf '%s' "${listen##*:}"
}

get_stun_port() {
  local stun
  stun="$(read_env_value "$ENV_FILE" "NB_STUN_PORTS")"
  printf '%s' "${stun%%,*}"
}

print_alma_status_block() {
  local state_label port access_label domain url_label key_val
  if is_alma_running; then
    state_label="$(msg alma_state_running)"
  elif has_alma_service && [[ -f "$ALMA_ENV_FILE" ]]; then
    state_label="$(msg alma_state_stopped)"
  else
    state_label="$(msg alma_state_not_installed)"
  fi

  port="$(read_env_value "$ALMA_ENV_FILE" "PORT")"
  key_val="$(read_env_value "$ALMA_ENV_FILE" "RELAY_REGISTRATION_KEY")"
  domain="$(get_relay_domain)"

  if [[ -z "$port" ]]; then
    port="-"
    access_label="-"
    url_label="-"
  else
    if [[ -n "$key_val" ]]; then
      access_label="$(msg alma_access_key)"
    else
      access_label="$(msg alma_access_open)"
    fi
    if [[ -n "$domain" ]]; then
      url_label="https://${domain}:${port}"
    else
      url_label="https://<domain>:${port}"
    fi
  fi

  cat <<EOF
=================================================
                $(msg alma_menu_title)
=================================================
$(msg alma_info_status "$state_label")
$(msg alma_info_port "$port")
$(msg alma_info_access "$access_label")
$(msg alma_info_url "$url_label")
-------------------------------------------------
$(msg alma_opt1)
$(msg alma_opt2)
$(msg alma_opt3)
$(msg alma_opt4)
$(msg alma_opt0)
=================================================
EOF
}

configure_alma_interactive() {
  local setup_script="${INSTALLER_DIR}/setup-relay.sh"
  if [[ ! -r "$setup_script" ]]; then
    echo "$(msg alma_setup_missing "$setup_script")"
    return 1
  fi

  local cert_file key_file current_port new_port new_key nb_port stun_port domain
  cert_file="$(read_env_value "$ENV_FILE" "NB_TLS_CERT_FILE")"
  key_file="$(read_env_value "$ENV_FILE" "NB_TLS_KEY_FILE")"
  cert_file="${cert_file:-/etc/netbird-relay/certs/fullchain.pem}"
  key_file="${key_file:-/etc/netbird-relay/certs/privkey.pem}"

  if [[ ! -s "$cert_file" || ! -s "$key_file" ]]; then
    echo "$(msg alma_need_nb_cert "$cert_file")"
    return 1
  fi

  current_port="$(read_env_value "$ALMA_ENV_FILE" "PORT")"
  current_port="${current_port:-8787}"
  printf '%s' "$(msg alma_port_prompt "$current_port")"
  IFS= read -r new_port || new_port=""
  new_port="${new_port:-$current_port}"

  nb_port="$(get_relay_port)"
  stun_port="$(get_stun_port)"
  if [[ ! "$new_port" =~ ^[0-9]+$ ]] || (( new_port < 1024 || new_port > 65535 )) \
    || [[ "$new_port" == "$nb_port" || "$new_port" == "$stun_port" || "$new_port" == "9000" || "$new_port" == "9090" ]]; then
    echo "$(msg alma_invalid_port "$new_port")"
    return 1
  fi

  printf '%s' "$(msg alma_key_prompt)"
  IFS= read -r new_key || new_key=""

  (
    RELS_LANG="$RELS_LANG"
    # shellcheck disable=SC1090
    source "$setup_script"
    configure_alma_relay "$new_port" "$new_key" "$cert_file" "$key_file"
  )

  domain="$(get_relay_domain)"
  if [[ -n "$domain" ]]; then
    echo "$(msg alma_configured "https://${domain}:${new_port}")"
  else
    echo "$(msg alma_configured "https://<domain>:${new_port}")"
  fi
}

start_restart_alma() {
  if ! has_alma_service || [[ ! -f "$ALMA_ENV_FILE" ]]; then
    echo "$(msg alma_not_installed_hint)"
    return 1
  fi
  if command -v systemctl >/dev/null 2>&1; then
    systemctl enable --now alma-relay
    systemctl restart alma-relay
  elif command -v service >/dev/null 2>&1; then
    rc-update add alma-relay default >/dev/null 2>&1 || true
    service alma-relay restart
  else
    fail "$(msg no_service_mgr)"
  fi
  echo "$(msg alma_started)"
}

stop_disable_alma() {
  if ! has_alma_service; then
    echo "$(msg alma_not_installed_hint)"
    return 1
  fi
  if command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now alma-relay || true
  elif command -v service >/dev/null 2>&1; then
    service alma-relay stop || true
    rc-update del alma-relay default >/dev/null 2>&1 || true
  else
    fail "$(msg no_service_mgr)"
  fi
  echo "$(msg alma_stopped)"
}

manage_alma_relay() {
  local sub=""
  while true; do
    clear || true
    print_alma_status_block
    printf '%s' "$(msg select_opt)"
    IFS= read -r sub || sub="0"
    case "$sub" in
      1) configure_alma_interactive || true ;;
      2) start_restart_alma || true ;;
      3) stop_disable_alma || true ;;
      4)
        if has_alma_service; then
          follow_service_logs "alma-relay"
        else
          echo "$(msg alma_not_installed_hint)"
        fi
        ;;
      0) return 0 ;;
      *) echo "$(msg invalid_opt "$sub")" ;;
    esac
    printf '\n%s' "$(msg press_enter)"
    IFS= read -r _ || true
  done
}

show_certificate_status() {
  load_env_file

  local relay_cert="${NB_TLS_CERT_FILE:-/etc/netbird-relay/certs/fullchain.pem}"
  local relay_key="${NB_TLS_KEY_FILE:-/etc/netbird-relay/certs/privkey.pem}"
  local not_before="-"
  local not_after="-"
  local remaining_days="-"
  local expires_soon
  local renewal_status
  expires_soon="$(msg unknown)"
  renewal_status="$(msg acme_none)"

  if [[ -s "$relay_cert" ]]; then
    not_before="$(openssl x509 -in "$relay_cert" -noout -startdate | cut -d= -f2-)"
    not_after="$(openssl x509 -in "$relay_cert" -noout -enddate | cut -d= -f2-)"
    if end_epoch="$(date -d "$not_after" +%s 2>/dev/null)"; then
      now_epoch="$(date +%s)"
      remaining_days="$(( (end_epoch - now_epoch) / 86400 ))"
    fi
    if openssl x509 -in "$relay_cert" -checkend 2592000 -noout >/dev/null 2>&1; then
      expires_soon="$(msg no)"
    else
      expires_soon="$(msg yes)"
    fi
  fi

  if [[ -x "${HOME}/.acme.sh/acme.sh" ]]; then
    if crontab -l 2>/dev/null | grep -q ".acme.sh"; then
      renewal_status="$(msg acme_cron_ok)"
    else
      renewal_status="$(msg acme_cron_missing)"
    fi
  fi

  cat <<EOF
$(msg cert_title)
$(msg cert_file "$relay_cert")
$(msg key_file "$relay_key")
$(msg cert_from "$not_before")
$(msg cert_until "$not_after")
$(msg cert_days "$remaining_days")
$(msg cert_soon "$expires_soon")
$(msg cert_renewal "$renewal_status")
EOF
}

show_system_optimization_status() {
  cat <<EOF
$(msg sys_title)
ZRAM:
$(zramctl 2>/dev/null || msg zram_none)

Swap:
$(swapon --show 2>/dev/null || msg swap_none)

Kernel:
swappiness=$(sysctl -n vm.swappiness 2>/dev/null || msg unknown)
page-cluster=$(sysctl -n vm.page-cluster 2>/dev/null || msg unknown)
default_qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null || msg unknown)
tcp_congestion_control=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || msg unknown)
somaxconn=$(sysctl -n net.core.somaxconn 2>/dev/null || msg unknown)
netdev_max_backlog=$(sysctl -n net.core.netdev_max_backlog 2>/dev/null || msg unknown)
======================================================
EOF
}

print_menu() {
  clear || true
  cat <<EOF
=================================================
         $(msg menu_title)
=================================================
$(msg m1)
$(msg m2)
$(msg m3)
$(msg m4)
$(msg m5)
$(msg m6)
$(msg m7)
$(msg m8)
$(msg m9)
$(msg m10)
$(msg ml)
$(msg m0)
=================================================
EOF
}

main() {
  init_language
  while true; do
    print_menu
    printf '%s' "$(msg select_opt)"
    IFS= read -r choice || exit 0
    case "$choice" in
      1) run_install ;;
      2) update_binary ;;
      3) update_scripts ;;
      4) show_status ;;
      5) show_logs ;;
      6) restart_service ;;
      7) manage_alma_relay; continue ;;
      8) show_certificate_status ;;
      9) show_system_optimization_status ;;
      10) rollback_binary ;;
      l|L) toggle_language; continue ;;
      0) exit 0 ;;
      *) echo "$(msg invalid_opt "$choice")" ;;
    esac
    printf '\n%s' "$(msg press_enter)"
    IFS= read -r _ || true
  done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
