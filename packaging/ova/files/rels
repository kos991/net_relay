    m9) printf '%s' "9) Show ZRAM and kernel tuning status" ;;
    m10) printf '%s' "10) Rollback NetBird Relay to previous backup" ;;
    ml) printf '%s' "L) Switch language (切换为中文)" ;;
    m0) printf '%s' "0) Exit" ;;
    select_opt) printf '%s' "Select an option: " ;;
    invalid_opt) printf 'Invalid option: %s' "$1" ;;
    press_enter) printf '%s' "Press Enter to continue..." ;;
    alma_menu_title) printf '%s' "Alma Relay Management" ;;
    alma_state_running) printf '%s' "running" ;;
    alma_state_stopped) printf '%s' "stopped" ;;
    alma_state_not_installed) printf '%s' "not installed / not configured" ;;
    alma_access_open) printf '%s' "open (no registration key)" ;;
    alma_access_key) printf '%s' "protected (registration key set)" ;;
