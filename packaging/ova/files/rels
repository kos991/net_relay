configure_alma_interactive() {
  local setup_script="${INSTALLER_DIR}/setup-relay.sh"
  if [[ ! -r "$setup_script" ]]; then
    echo "$(msg alma_setup_missing "$setup_script")"
    return 1
  fi

  local cert_file key_file current_port new_port new_key nb_port stun_port domain
  cert_file="$(read_env_value "$ENV_FILE" "NB_TLS_CERT_FILE")"
  key_file="$(read_env_value "$ENV_FILE" "NB_TLS_KEY_FILE")"
  cert_file="${cert_file:-/etc/netbird-relay/certs/fullchain.pem}"
  key_file="${key_file:-/etc/netbird-relay/certs/privkey.pem}"

  if [[ ! -s "$cert_file" || ! -s "$key_file" ]]; then
    echo "$(msg alma_need_nb_cert "$cert_file")"
    return 1
  fi

  current_port="$(read_env_value "$ALMA_ENV_FILE" "PORT")"
  current_port="${current_port:-8787}"
  printf '%s' "$(msg alma_port_prompt "$current_port")"
  IFS= read -r new_port || new_port=""
  new_port="${new_port:-$current_port}"

  nb_port="$(get_relay_port)"
  stun_port="$(get_stun_port)"
  if [[ ! "$new_port" =~ ^[0-9]+$ ]] || (( new_port < 1024 || new_port > 65535 )) \
    || [[ "$new_port" == "$nb_port" || "$new_port" == "$stun_port" || "$new_port" == "9000" || "$new_port" == "9090" ]]; then
    echo "$(msg alma_invalid_port "$new_port")"
    return 1
  fi

  local current_key key_input
  current_key="$(read_env_value "$ALMA_ENV_FILE" "RELAY_REGISTRATION_KEY")"
  if [[ -n "$current_key" ]]; then
    printf '%s' "$(msg alma_key_keep_prompt)"
    IFS= read -r key_input || key_input=""
    if [[ -z "$key_input" ]]; then
      new_key="$current_key"
    elif [[ "$key_input" == "-" ]]; then
      new_key=""
    else
      new_key="$key_input"
    fi
  else
    printf '%s' "$(msg alma_key_prompt)"
    IFS= read -r new_key || new_key=""
  fi

  (
    RELS_LANG="$RELS_LANG"
    # shellcheck disable=SC1090
    source "$setup_script"
    configure_alma_relay "$new_port" "$new_key" "$cert_file" "$key_file"
  )

  domain="$(get_relay_domain)"
  if [[ -n "$domain" ]]; then
    echo "$(msg alma_configured "https://${domain}:${new_port}")"
  else
    echo "$(msg alma_configured "https://<domain>:${new_port}")"
  fi
  if [[ -n "$new_key" ]]; then
    echo "$(msg alma_info_key "$new_key")"
  else
    echo "$(msg alma_info_key "$(msg alma_key_none)")"
  fi
}

