#!/usr/bin/env bash
set -euo pipefail

INSTALLER_DIR="/opt/netbird-relay-installer"
ENV_FILE="/etc/netbird-relay/relay.env"

fail() {
  echo "Error: $*" >&2
  exit 1
}

require_installer_dir() {
  [[ -d "$INSTALLER_DIR" ]] || fail "installer directory is missing: ${INSTALLER_DIR}"
}

run_install() {
  require_installer_dir
  cd "$INSTALLER_DIR"
  bash ./setup-relay.sh
}

update_binary() {
  require_installer_dir
  cd "$INSTALLER_DIR"
  echo "Downloading and installing the latest netbird-relay binary..."
  bash ./install.sh
}

show_status() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl status netbird-relay --no-pager
  elif command -v service >/dev/null 2>&1; then
    service netbird-relay status
  else
    fail "systemd or OpenRC was not found."
  fi
}

show_logs() {
  if command -v journalctl >/dev/null 2>&1; then
    journalctl -u netbird-relay -f -n 120
  else
    tail -f /var/log/netbird-relay.log /var/log/netbird-relay.err
  fi
}

restart_service() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl restart netbird-relay
  elif command -v service >/dev/null 2>&1; then
    service netbird-relay restart
  else
    fail "systemd or OpenRC was not found."
  fi
}

load_env_file() {
  if [[ -f "$ENV_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
  fi
}

show_certificate_status() {
  load_env_file

  local relay_cert="${NB_TLS_CERT_FILE:-/etc/netbird-relay/certs/fullchain.pem}"
  local relay_key="${NB_TLS_KEY_FILE:-/etc/netbird-relay/certs/privkey.pem}"
  local not_before="-"
  local not_after="-"
  local remaining_days="-"
  local expires_soon="unknown"
  local renewal_status="acme.sh not detected"

  if [[ -s "$relay_cert" ]]; then
    not_before="$(openssl x509 -in "$relay_cert" -noout -startdate | cut -d= -f2-)"
    not_after="$(openssl x509 -in "$relay_cert" -noout -enddate | cut -d= -f2-)"
    if end_epoch="$(date -d "$not_after" +%s 2>/dev/null)"; then
      now_epoch="$(date +%s)"
      remaining_days="$(( (end_epoch - now_epoch) / 86400 ))"
    fi
    if openssl x509 -in "$relay_cert" -checkend 2592000 -noout >/dev/null 2>&1; then
      expires_soon="no"
    else
      expires_soon="yes"
    fi
  fi

  if [[ -x "${HOME}/.acme.sh/acme.sh" ]]; then
    if crontab -l 2>/dev/null | grep -q ".acme.sh"; then
      renewal_status="acme.sh cron renewal is configured"
    else
      renewal_status="acme.sh is installed, but cron renewal was not detected"
    fi
  fi

  cat <<EOF
==================== Certificate Status ====================
Relay certificate file: ${relay_cert}
Relay private key file: ${relay_key}
Certificate valid from: ${not_before}
Certificate valid until: ${not_after}
Remaining days: ${remaining_days}
Expires within 30 days: ${expires_soon}
Certificate renewal: ${renewal_status}
EOF
}

show_system_optimization_status() {
  cat <<EOF
==================== System Optimization Status ====================
ZRAM:
$(zramctl 2>/dev/null || echo "zramctl output was not detected")

Swap:
$(swapon --show 2>/dev/null || echo "swap output was not detected")

Kernel:
swappiness=$(sysctl -n vm.swappiness 2>/dev/null || echo unknown)
page-cluster=$(sysctl -n vm.page-cluster 2>/dev/null || echo unknown)
default_qdisc=$(sysctl -n net.core.default_qdisc 2>/dev/null || echo unknown)
tcp_congestion_control=$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || echo unknown)
somaxconn=$(sysctl -n net.core.somaxconn 2>/dev/null || echo unknown)
netdev_max_backlog=$(sysctl -n net.core.netdev_max_backlog 2>/dev/null || echo unknown)
======================================================
EOF
}

print_menu() {
  clear || true
  cat <<'EOF'
=================================================
              NetBird Relay Management Menu
=================================================
1) Install or reconfigure Relay
2) Update binary and restart service
3) Show service status
4) Show service logs
5) Restart service
6) Show certificate status
7) Show ZRAM and kernel tuning status
0) Exit
=================================================
EOF
}

while true; do
  print_menu
  printf 'Select an option: '
  IFS= read -r choice
  case "$choice" in
    1) run_install ;;
    2) update_binary ;;
    3) show_status ;;
    4) show_logs ;;
    5) restart_service ;;
    6) show_certificate_status ;;
    7) show_system_optimization_status ;;
    0) exit 0 ;;
    *) echo "Invalid option: ${choice}" ;;
  esac
  printf '\nPress Enter to continue...'
  IFS= read -r _
done
