parse_cert_epoch() {
  local raw="$1"
  local epoch=""
  if epoch="$(LC_ALL=C date -d "$raw" +%s 2>/dev/null)" && [[ "$epoch" =~ ^[0-9]+$ ]]; then
    printf '%s' "$epoch"
    return 0
  fi
  if command -v node >/dev/null 2>&1; then
    epoch="$(node -e 'const t = Date.parse(process.argv[1]); if (!Number.isNaN(t)) process.stdout.write(String(Math.floor(t / 1000)));' "$raw" 2>/dev/null || true)"
    if [[ "$epoch" =~ ^[0-9]+$ ]]; then
      printf '%s' "$epoch"
      return 0
    fi
  fi
  if command -v python3 >/dev/null 2>&1; then
    epoch="$(python3 -c 'import email.utils, sys; dt = email.utils.parsedate_to_datetime(sys.argv[1]); print(int(dt.timestamp()))' "$raw" 2>/dev/null || true)"
    if [[ "$epoch" =~ ^[0-9]+$ ]]; then
      printf '%s' "$epoch"
      return 0
    fi
  fi
  return 1
}

show_certificate_status() {
  load_env_file

  local relay_cert="${NB_TLS_CERT_FILE:-/etc/netbird-relay/certs/fullchain.pem}"
  local relay_key="${NB_TLS_KEY_FILE:-/etc/netbird-relay/certs/privkey.pem}"
  local not_before="-"
  local not_after="-"
  local remaining_days="-"
  local expires_soon="$(msg unknown)"
  local renewal_status="$(msg acme_missing)"

  if [[ -s "$relay_cert" ]]; then
    not_before="$(openssl x509 -in "$relay_cert" -noout -startdate | cut -d= -f2-)"
    not_after="$(openssl x509 -in "$relay_cert" -noout -enddate | cut -d= -f2-)"
    if end_epoch="$(parse_cert_epoch "$not_after")"; then
      now_epoch="$(date +%s)"
      remaining_days="$(( (end_epoch - now_epoch) / 86400 ))"
    fi
    if openssl x509 -in "$relay_cert" -checkend 2592000 -noout >/dev/null 2>&1; then
      expires_soon="$(msg no)"
    else
      expires_soon="$(msg yes)"
    fi
  fi

  local has_acme=0
  if command -v acme.sh >/dev/null 2>&1 || [[ -x /root/.acme.sh/acme.sh || -x "${HOME}/.acme.sh/acme.sh" ]]; then
    has_acme=1
  fi
  if [[ "$has_acme" == "1" ]]; then
    if crontab -l 2>/dev/null | grep -Eq '(^|[^[:alnum:]_])acme\.sh([^[:alnum:]_]|$)|\.acme\.sh' \
      || grep -Rqs 'acme\.sh' /etc/cron.d /etc/periodic /var/spool/cron/crontabs 2>/dev/null; then
      renewal_status="$(msg acme_cron_ok)"
    else
      renewal_status="$(msg acme_cron_missing)"
    fi
  fi

  cat <<EOF
$(msg cert_title)
$(msg cert_file "$relay_cert")
$(msg key_file "$relay_key")
$(msg cert_from "$not_before")
$(msg cert_until "$not_after")
$(msg cert_days "$remaining_days")
$(msg cert_soon "$expires_soon")
$(msg cert_renewal "$renewal_status")
EOF
}

