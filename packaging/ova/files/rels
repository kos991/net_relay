      alma_opt3) printf '%s' "3) 停止并禁用 Alma Relay" ;;
      alma_opt4) printf '%s' "4) 查看 Alma Relay 实时日志" ;;
      alma_opt0) printf '%s' "0) 返回主菜单" ;;
      alma_port_prompt) printf 'Alma Relay 端口 [%s]：' "$1" ;;
      alma_key_prompt) printf '%s' "Alma Relay 访问密钥（留空为公开访问）：" ;;
      alma_invalid_port) printf '无效端口：%s（需为 1024-65535，且不能与 NetBird/9000/9090 冲突）' "$1" ;;
