#!/usr/bin/env bash
set -euo pipefail

log() {
  echo "ZRAM：$*"
}

apt_run() {
  if command -v flock >/dev/null 2>&1; then
    flock /var/lib/dpkg/lock-frontend apt-get "$@"
  else
    apt-get "$@"
  fi
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "错误：缺少必需命令：$1" >&2
    exit 1
  }
}

wait_for_zram_device() {
  local i
  for i in 1 2 3 4 5; do
    [[ -b /dev/zram0 ]] && return 0
    sleep 1
  done
  return 1
}

write_zram_start_script() {
  cat > /usr/local/bin/zram-start.sh <<EOF
#!/usr/bin/env bash
set -euo pipefail
modprobe zram 2>/dev/null || true
for i in 1 2 3 4 5; do
  [[ -b /dev/zram0 ]] && break
  sleep 1
done
[[ -b /dev/zram0 ]] || { echo "错误：未创建 /dev/zram0" >&2; exit 1; }
swapoff /dev/zram0 2>/dev/null || true
echo 1 > /sys/block/zram0/reset 2>/dev/null || true
echo ${BEST_ALGO} > /sys/block/zram0/comp_algorithm
echo ${ZRAM_SIZE} > /sys/block/zram0/disksize
mkswap /dev/zram0 >/dev/null
swapon -p 100 /dev/zram0
EOF
  chmod +x /usr/local/bin/zram-start.sh
}

write_openrc_service() {
  cat > /etc/init.d/zram <<'EOF'
#!/sbin/openrc-run
description="ZRAM optimized swap"
command="/usr/local/bin/zram-start.sh"
command_background="no"
pidfile="/run/zram.pid"

depend() {
  need localmount
  before swap
}

start() {
  ebegin "Starting ZRAM swap"
  ${command}
  eend $?
}

stop() {
  ebegin "Stopping ZRAM swap"
  swapoff /dev/zram0 2>/dev/null || true
  echo 1 > /sys/block/zram0/reset 2>/dev/null || true
  eend 0
}
EOF
  chmod +x /etc/init.d/zram
}

verify_zram_swap() {
  if ! swapon --show=NAME --noheadings 2>/dev/null | awk '$1 == "/dev/zram0" {found=1} END {exit !found}'; then
    echo "错误：/dev/zram0 swap 未启用" >&2
    zramctl 2>/dev/null || true
    swapon --show 2>/dev/null || true
    return 1
  fi
}

if [[ "$(id -u)" -ne 0 ]]; then
  echo "错误：请使用 root 运行" >&2
  exit 1
fi

if [[ -f /etc/alpine-release ]]; then
  OS="alpine"
elif [[ -f /etc/debian_version ]]; then
  OS="debian"
else
  echo "错误：不支持当前操作系统" >&2
  exit 1
fi

TOTAL_MEM="$(free -m | awk '/^Mem:/ {print $2}')"
[[ "$TOTAL_MEM" =~ ^[0-9]+$ ]] || TOTAL_MEM=512
ZRAM_SIZE="${TOTAL_MEM}M"

modprobe zram 2>/dev/null || true
wait_for_zram_device || true
BEST_ALGO="lzo"
if [[ -f /sys/block/zram0/comp_algorithm ]]; then
  ALGOS="$(cat /sys/block/zram0/comp_algorithm)"
  for algo in zstd lz4 lzo-rle; do
    if echo "$ALGOS" | grep -q "$algo"; then
      BEST_ALGO="$algo"
      break
    fi
  done
fi

log "size=${ZRAM_SIZE}, algorithm=${BEST_ALGO}"
write_zram_start_script

if [[ "$OS" == "alpine" ]]; then
  require_cmd mkswap
  require_cmd swapon
  require_cmd rc-update
  require_cmd rc-service
  require_cmd crontab
  write_openrc_service
  rc-update add zram default
  rc-service zram restart
else
  apt_run update
  apt_run install -y util-linux cron
  cat > /etc/systemd/system/zram.service <<'EOF'
[Unit]
Description=ZRAM Optimized Swap
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/zram-start.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable zram
  systemctl restart zram || true
fi

verify_zram_swap

sysctl -w vm.swappiness=100 || true
sysctl -w vm.page-cluster=0 || true
sed -i '/vm.swappiness/d;/vm.page-cluster/d' /etc/sysctl.conf
{
  echo "vm.swappiness=100"
  echo "vm.page-cluster=0"
} >> /etc/sysctl.conf

cat > /usr/local/bin/zram-optimize.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ -f /sys/block/zram0/compact ]]; then
  echo 1 > /sys/block/zram0/compact
  echo "[$(date)] ZRAM 压缩整理完成"
fi
EOF
chmod +x /usr/local/bin/zram-optimize.sh

if [[ "$OS" == "alpine" ]]; then
  mkdir -p /var/spool/cron/crontabs
  if ! crontab -l 2>/dev/null | grep -q "zram-optimize"; then
    (crontab -l 2>/dev/null; echo "0 3 * * * /usr/local/bin/zram-optimize.sh") | crontab -
  fi
  rc-service crond start 2>/dev/null || true
  rc-update add crond default 2>/dev/null || true
else
  (crontab -l 2>/dev/null | grep -v "zram-optimize"; echo "0 3 * * * /usr/local/bin/zram-optimize.sh") | crontab -
  systemctl enable --now cron >/dev/null 2>&1 || true
fi

/usr/local/bin/zram-optimize.sh || true
zramctl || true
