#!/usr/bin/env bash
set -euo pipefail

log() {
  echo "根分区扩容：$*"
}

apt_run() {
  if command -v flock >/dev/null 2>&1; then
    flock /var/lib/dpkg/lock-frontend apt-get "$@"
  else
    apt-get "$@"
  fi
}

if [[ "$(id -u)" -ne 0 ]]; then
  echo "错误：请使用 root 运行" >&2
  exit 1
fi

install_resize_tools() {
  if command -v growpart >/dev/null 2>&1; then
    return 0
  fi

  if [[ -f /etc/alpine-release ]] && command -v apk >/dev/null 2>&1; then
    apk add --no-cache cloud-utils-growpart e2fsprogs-extra xfsprogs util-linux >/dev/null 2>&1 || true
  elif [[ -f /etc/debian_version ]] && command -v apt-get >/dev/null 2>&1; then
    apt_run update || true
    apt_run install -y cloud-guest-utils e2fsprogs xfsprogs util-linux || true
  fi
}

root_source="$(findmnt -n -o SOURCE /)"
root_fs="$(findmnt -n -o FSTYPE /)"

if [[ -z "$root_source" || "$root_source" != /dev/* ]]; then
  log "跳过：根目录来源不是块设备分区（${root_source:-未知}）"
  exit 0
fi

partition_name="$(basename "$root_source")"
disk_name="$(lsblk -no PKNAME "$root_source" 2>/dev/null | head -n 1 || true)"
part_number="$(cat "/sys/class/block/${partition_name}/partition" 2>/dev/null || true)"

if [[ -z "$disk_name" || -z "$part_number" ]]; then
  log "跳过：无法检测 $root_source 对应的父磁盘或分区号"
  exit 0
fi

disk="/dev/${disk_name}"
install_resize_tools

if command -v growpart >/dev/null 2>&1; then
  log "正在扩展 ${disk} 的分区 ${part_number}"
  growpart "$disk" "$part_number" || true
  partprobe "$disk" 2>/dev/null || true
  blockdev --rereadpt "$disk" 2>/dev/null || true
else
  log "跳过分区扩容：未找到 growpart"
fi

case "$root_fs" in
  ext2|ext3|ext4)
    resize2fs "$root_source" || true
    ;;
  xfs)
    xfs_growfs / || true
    ;;
  btrfs)
    btrfs filesystem resize max / || true
    ;;
  *)
    log "跳过文件系统扩容：不支持的文件系统 ${root_fs:-未知}"
    ;;
esac

df -h / || true
