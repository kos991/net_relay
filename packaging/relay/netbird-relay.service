[Unit]
Description=NetBird Relay
Documentation=https://github.com/netbirdio/netbird
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/netbird-relay/relay.env
ExecStart=/usr/local/bin/netbird-relay
Restart=always
RestartSec=5
User=netbird-relay
Group=netbird-relay
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/netbird-relay /var/log
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
