#!/sbin/openrc-run

name="NetBird Relay"
description="NetBird Relay"
command=/usr/local/bin/netbird-relay
command_user="netbird-relay:netbird-relay"
command_background=true
pidfile=/run/netbird-relay.pid
output_log=/var/log/netbird-relay.log
error_log=/var/log/netbird-relay.err

depend() {
  need net
  after firewall
}

start_pre() {
  local relay_env_file="${RELAY_ENV_FILE:-/etc/netbird-relay/relay.env}"
  checkpath --directory --mode 0755 /run
  checkpath --directory --mode 0755 /var/log
  checkpath --file --owner netbird-relay:netbird-relay --mode 0640 "$output_log"
  checkpath --file --owner netbird-relay:netbird-relay --mode 0640 "$error_log"
  if [ -f "$relay_env_file" ]; then
    while IFS= read -r line; do
      key="${line%%=*}"
      value="${line#*=}"
      case "$key" in
        NB_LOG_LEVEL|NB_LOG_FILE|NB_LISTEN_ADDRESS|NB_EXPOSED_ADDRESS|NB_AUTH_SECRET|NB_ENABLE_STUN|NB_STUN_PORTS|NB_TLS_CERT_FILE|NB_TLS_KEY_FILE|NB_HEALTH_LISTEN_ADDRESS|NB_METRICS_PORT)
          export "$key=$value"
          ;;
      esac
    done < "$relay_env_file"
  fi
}
