[Unit]
Description=Alma Remote Access Relay
Documentation=https://github.com/yetone/alma-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/alma-relay/relay.env
ExecStart=/usr/bin/node /usr/local/lib/alma-relay/alma-relay.cjs
Restart=always
RestartSec=5
User=alma-relay
Group=alma-relay
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/alma-relay /var/log

[Install]
WantedBy=multi-user.target
