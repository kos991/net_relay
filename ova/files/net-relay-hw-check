#!/usr/bin/env sh
set -eu

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

has_module() {
  grep -qw "$1" /proc/modules 2>/dev/null
}

check() {
  name="$1"
  shift
  if "$@"; then
    printf '[ OK ] %s\n' "$name"
  else
    printf '[WARN] %s\n' "$name"
  fi
}

printf 'Net Relay image check\n'
printf '=====================\n'
printf 'Kernel: %s\n' "$(uname -r)"
printf '\n'

check 'cloud-init command exists' has_cmd cloud-init
check 'qemu guest agent command exists' has_cmd qemu-ga
check 'virtio block module loaded' has_module virtio_blk
check 'virtio net module loaded' has_module virtio_net
check 'NVMe module loaded' has_module nvme
check 'BBR enabled' sh -c '[ "$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null || true)" = "bbr" ]'

printf '\nNetwork tools:\n'
for cmd in wget curl git vim nano unzip zip rsync ip ping arping tracepath traceroute mtr dig telnet nmap iperf3 tcpdump lsof socat whois; do
  if has_cmd "$cmd"; then
    printf '[ OK ] %s\n' "$cmd"
  else
    printf '[WARN] %s\n' "$cmd"
  fi
done

printf '\nService state:\n'
rc-status default 2>/dev/null | grep -E 'docker|sshd|qemu|cloud' || true
