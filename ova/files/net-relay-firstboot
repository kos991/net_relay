#!/usr/bin/env bash
set -euo pipefail

FLAG="/var/lib/net-relay/firstboot.done"
INSTALLER_DIR="/opt/netbird-relay-installer"
BIN_PATH="/usr/local/bin/netbird-relay"
ROOT_RESIZE="/usr/local/sbin/setup-root-resize"
NETWORK_CHECK="/usr/local/sbin/setup-network-check"
ZRAM_SETUP="/usr/local/sbin/setup-zram"
KERNEL_TUNING="/usr/local/sbin/setup-kernel-tuning"

fail() {
  echo "error: $*" >&2
  exit 1
}

check_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "missing required command: $1"
}

check_disk_space() {
  local available_mb
  available_mb="$(df -Pm / | awk 'NR == 2 {print $4}')"
  [[ "$available_mb" =~ ^[0-9]+$ ]] || fail "unable to check free space on /"
  (( available_mb >= 256 )) || fail "/ needs at least 256 MB free, current ${available_mb} MB"
}

run_preflight_checks() {
  echo "Running OVA boot preflight checks..."
  [[ -d "$INSTALLER_DIR" ]] || fail "installer directory missing: ${INSTALLER_DIR}"
  [[ -x "$BIN_PATH" ]] || fail "netbird-relay binary missing: ${BIN_PATH}"
  [[ -x "$ROOT_RESIZE" ]] || fail "root resize script missing: ${ROOT_RESIZE}"
  [[ -x "$NETWORK_CHECK" ]] || fail "network check script missing: ${NETWORK_CHECK}"
  [[ -x "$ZRAM_SETUP" ]] || fail "zram setup script missing: ${ZRAM_SETUP}"
  [[ -x "$KERNEL_TUNING" ]] || fail "kernel tuning script missing: ${KERNEL_TUNING}"
  check_cmd bash
  check_cmd curl
  check_cmd openssl
  check_disk_space
  echo "Preflight checks completed."
}

if [[ -f "$FLAG" ]]; then
  exit 0
fi

clear || true
cat <<'EOF'
=================================================
          NetBird Relay OVA firstboot
=================================================

Default login:
- User: root
- SSH port: __SSH_PORT__

Notes:
- First login forces a root password change.
- Firstboot checks the relay binary, disk space, network, ZRAM, and kernel tuning.
- Run "rels" later to open the management menu.
- Multi-node relay groups are supported; all nodes in a group must reuse the same secret.
=================================================
EOF

run_preflight_checks
"$ROOT_RESIZE" || echo "warning: root resize failed, continuing Relay setup."
"$NETWORK_CHECK" || echo "warning: network self-check failed, continuing Relay setup."
"$ZRAM_SETUP" || echo "warning: ZRAM setup failed, continuing Relay setup."
"$KERNEL_TUNING" || echo "warning: kernel tuning failed, continuing Relay setup."

cd "$INSTALLER_DIR"
bash ./setup-relay.sh

mkdir -p "$(dirname "$FLAG")"
touch "$FLAG"
