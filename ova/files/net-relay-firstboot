#!/usr/bin/env bash
set -euo pipefail

FLAG="/var/lib/net-relay/firstboot.done"
INSTALLER_DIR="/opt/netbird-relay-installer"

fail() {
  echo "ERROR: $*" >&2
  exit 1
}

check_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "Missing required command: $1"
}

wait_for_docker() {
  local attempts=60
  while (( attempts > 0 )); do
    if [[ -S /var/run/docker.sock ]] && docker info >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    attempts=$((attempts - 1))
  done
  return 1
}

force_start_docker() {
  rc-service docker stop >/dev/null 2>&1 || true
  rm -f /run/docker.pid /var/run/docker.pid /run/docker.sock /var/run/docker.sock
  rc-service docker start >/dev/null 2>&1 || true
}

check_compose() {
  docker compose version >/dev/null 2>&1 || command -v docker-compose >/dev/null 2>&1 || fail "Docker Compose is unavailable."
}

check_disk_space() {
  local target="/"
  local min_mb=768
  local available_mb

  if [[ -d /var/lib/docker ]]; then
    target="/var/lib/docker"
  fi

  available_mb="$(df -Pm "$target" | awk 'NR == 2 {print $4}')"
  [[ "$available_mb" =~ ^[0-9]+$ ]] || fail "Unable to check free disk space on ${target}."
  (( available_mb >= min_mb )) || fail "Need at least ${min_mb} MB free on ${target}; available ${available_mb} MB."
}

check_image_pull() {
  local image="$1"

  echo "Checking image: ${image}"
  if docker image inspect "$image" >/dev/null 2>&1; then
    return 0
  fi
  docker pull "$image" >/dev/null || fail "Unable to pull image: ${image}"
}

run_preflight_checks() {
  echo "Running OVA preflight checks..."
  [[ -d "$INSTALLER_DIR" ]] || fail "Installer directory not found: ${INSTALLER_DIR}"
  check_cmd bash
  check_cmd curl
  check_cmd docker
  check_cmd openssl
  docker info >/dev/null 2>&1 || fail "Docker daemon is unavailable."
  check_compose
  check_disk_space
  check_image_pull "${RELAY_IMAGE}"
  check_image_pull "${CADDY_IMAGE}"
  check_image_pull "${SYNC_IMAGE}"
  echo "Preflight checks passed."
}

if [[ -f "$FLAG" ]]; then
  exit 0
fi

clear || true
cat <<'EOF'
=================================================
              NetBird Relay OVA
=================================================

Tip:
- The VMware console may not display Chinese fonts.
- For a better setup experience, SSH into this VM.
- The installer will check Docker, Compose, disk space and images first.

=================================================
EOF

if ! wait_for_docker; then
  echo "Docker is not ready. Restarting Docker service..."
  force_start_docker
  wait_for_docker || fail "Docker is unavailable after restart. Check: rc-service docker status"
fi

if [[ "${RELAY_IMAGE:-__RELAY_IMAGE__}" == "__RELAY_IMAGE__" ]]; then
  RELAY_IMAGE="crpi-9kn2o1el6okkk1mu.cn-shanghai.personal.cr.aliyuncs.com/netrels/netrels:relay"
fi
if [[ "${CADDY_IMAGE:-__CADDY_IMAGE__}" == "__CADDY_IMAGE__" ]]; then
  CADDY_IMAGE="crpi-9kn2o1el6okkk1mu.cn-shanghai.personal.cr.aliyuncs.com/netrels/netrels:caddy"
fi
if [[ "${SYNC_IMAGE:-__SYNC_IMAGE__}" == "__SYNC_IMAGE__" ]]; then
  SYNC_IMAGE="crpi-9kn2o1el6okkk1mu.cn-shanghai.personal.cr.aliyuncs.com/netrels/netrels:sync"
fi

run_preflight_checks

cd "$INSTALLER_DIR"
CADDY_IMAGE="${CADDY_IMAGE}" \
SYNC_IMAGE="${SYNC_IMAGE}" \
RELAY_IMAGE="${RELAY_IMAGE}" \
bash ./setup-relay.sh

mkdir -p "$(dirname "$FLAG")"
touch "$FLAG"
