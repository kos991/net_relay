#!/usr/bin/env bash
set -euo pipefail

FLAG="/var/lib/net-relay/firstboot.done"
IMAGE_FLAG="/var/lib/net-relay/images.loaded"
INSTALLER_DIR="/opt/netbird-relay-installer"
IMAGE_TAR="/opt/net-relay/docker-images.tar"

if [[ -f "$FLAG" ]]; then
  exit 0
fi

clear || true
cat <<'EOF'
=================================================
              NetBird Relay OVA
=================================================

Tip:
- The VMware console may not display Chinese fonts.
- For a better setup experience, SSH into this VM.
- The installer will ask for Cloudflare DNS and Relay settings.

=================================================
EOF

rc-service docker start >/dev/null 2>&1 || true

if [[ ! -f "$IMAGE_FLAG" ]]; then
  echo "Loading bundled Docker images, please wait..."
  docker load -i "$IMAGE_TAR"
  mkdir -p "$(dirname "$IMAGE_FLAG")"
  touch "$IMAGE_FLAG"
fi

cd "$INSTALLER_DIR"
CADDY_IMAGE="net-relay-caddy:ova" \
SYNC_IMAGE="net-relay-sync:ova" \
bash ./setup-relay.sh

mkdir -p "$(dirname "$FLAG")"
touch "$FLAG"
