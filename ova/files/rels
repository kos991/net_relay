#!/usr/bin/env bash
set -euo pipefail

INSTALLER_DIR="/opt/netbird-relay-installer"
COMPOSE_CMD=()

fail() {
  echo "错误：$*" >&2
  exit 1
}

detect_compose() {
  if docker compose version >/dev/null 2>&1; then
    COMPOSE_CMD=(docker compose)
  elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE_CMD=(docker-compose)
  else
    fail "Docker Compose 不可用。"
  fi
}

require_installer_dir() {
  [[ -d "$INSTALLER_DIR" ]] || fail "安装器目录不存在：${INSTALLER_DIR}"
}

ensure_ova_docker() {
  if docker info >/dev/null 2>&1; then
    return 0
  fi

  echo "Docker 未就绪，正在重启 Docker 服务..."
  rc-service docker stop >/dev/null 2>&1 || true
  rm -f /run/docker.pid /var/run/docker.pid /run/docker.sock /var/run/docker.sock
  rc-service docker start >/dev/null 2>&1 || true

  local attempts=60
  while (( attempts > 0 )); do
    if docker info >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    attempts=$((attempts - 1))
  done

  fail "Docker 不可用，请执行：rc-service docker status"
}

require_compose_file() {
  require_installer_dir
  [[ -f "${INSTALLER_DIR}/docker-compose.yml" ]] || fail "未找到 docker-compose.yml，请先执行安装或重新配置。"
}

run_install() {
  require_installer_dir
  ensure_ova_docker
  cd "$INSTALLER_DIR"
  bash ./setup-relay.sh
}

upgrade_images() {
  ensure_ova_docker
  require_compose_file
  detect_compose
  cd "$INSTALLER_DIR"
  echo "正在拉取最新镜像..."
  "${COMPOSE_CMD[@]}" -f docker-compose.yml pull
  echo "正在重启服务..."
  "${COMPOSE_CMD[@]}" -f docker-compose.yml up -d
  echo "正在清理未使用镜像..."
  docker image prune -f
  echo "镜像更新完成。"
}

show_status() {
  ensure_ova_docker
  require_compose_file
  detect_compose
  cd "$INSTALLER_DIR"
  "${COMPOSE_CMD[@]}" -f docker-compose.yml ps
}

show_logs() {
  ensure_ova_docker
  require_compose_file
  detect_compose
  cd "$INSTALLER_DIR"
  "${COMPOSE_CMD[@]}" -f docker-compose.yml logs -f --tail=120 caddy sync-relay-certs relay
}

restart_services() {
  ensure_ova_docker
  require_compose_file
  detect_compose
  cd "$INSTALLER_DIR"
  "${COMPOSE_CMD[@]}" -f docker-compose.yml restart
}

print_menu() {
  clear || true
  cat <<'EOF'
=================================================
              NetBird Relay 管理菜单
=================================================
1) 安装或重新配置 Relay
2) 更新镜像并重启服务
3) 查看服务状态
4) 查看服务日志
5) 重启服务
0) 退出
=================================================
EOF
}

while true; do
  print_menu
  printf '请选择：'
  IFS= read -r choice
  case "$choice" in
    1) run_install ;;
    2) upgrade_images ;;
    3) show_status ;;
    4) show_logs ;;
    5) restart_services ;;
    0) exit 0 ;;
    *) echo "无效选择：${choice}" ;;
  esac
  printf '\n按 Enter 继续...'
  IFS= read -r _
done
