#!/usr/bin/env bash
set -euo pipefail

INSTALLER_DIR="/opt/netbird-relay-installer"
COMPOSE_CMD=()

fail() {
  echo "错误：$*" >&2
  exit 1
}

detect_compose() {
  if docker compose version >/dev/null 2>&1; then
    COMPOSE_CMD=(docker compose)
  elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE_CMD=(docker-compose)
  else
    fail "Docker Compose 不可用。"
  fi
}

require_installer_dir() {
  [[ -d "$INSTALLER_DIR" ]] || fail "安装器目录不存在：${INSTALLER_DIR}"
}

ensure_ova_docker() {
  if docker info >/dev/null 2>&1; then
    return 0
  fi

  echo "Docker 未就绪，正在重启 Docker 服务..."
  rc-service docker stop >/dev/null 2>&1 || true
  rm -f /run/docker.pid /var/run/docker.pid /run/docker.sock /var/run/docker.sock
  rc-service docker start >/dev/null 2>&1 || true

  local attempts=60
  while (( attempts > 0 )); do
    if docker info >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    attempts=$((attempts - 1))
  done

  fail "Docker 不可用，请执行：rc-service docker status"
}

require_compose_file() {
  require_installer_dir
  [[ -f "${INSTALLER_DIR}/docker-compose.yml" ]] || fail "未找到 docker-compose.yml，请先执行安装或重新配置。"
}

run_install() {
  require_installer_dir
  ensure_ova_docker
  cd "$INSTALLER_DIR"
  bash ./setup-relay.sh
}

upgrade_images() {
  ensure_ova_docker
  require_compose_file
  detect_compose
  cd "$INSTALLER_DIR"
  echo "正在拉取最新镜像..."
  "${COMPOSE_CMD[@]}" -f docker-compose.yml pull
  echo "正在重启服务..."
  "${COMPOSE_CMD[@]}" -f docker-compose.yml up -d
  echo "正在清理未使用镜像..."
  docker image prune -f
  echo "镜像更新完成。"
}

show_status() {
  ensure_ova_docker
  require_compose_file
  detect_compose
  cd "$INSTALLER_DIR"
  "${COMPOSE_CMD[@]}" -f docker-compose.yml ps
}

show_logs() {
  ensure_ova_docker
  require_compose_file
  detect_compose
  cd "$INSTALLER_DIR"
  "${COMPOSE_CMD[@]}" -f docker-compose.yml logs -f --tail=120 caddy sync-relay-certs relay
}

restart_services() {
  ensure_ova_docker
  require_compose_file
  detect_compose
  cd "$INSTALLER_DIR"
  "${COMPOSE_CMD[@]}" -f docker-compose.yml restart
}

load_env_file() {
  require_installer_dir
  if [[ -f "${INSTALLER_DIR}/.env" ]]; then
    set -a
    # shellcheck disable=SC1091
    . "${INSTALLER_DIR}/.env"
    set +a
  fi
}

find_caddy_cert() {
  local domain="${1:-}"
  if [[ -n "$domain" ]]; then
    find "${INSTALLER_DIR}/data/caddy" -type f -path "*/${domain}/*.crt" 2>/dev/null | sort | head -n 1
  else
    find "${INSTALLER_DIR}/data/caddy" -type f -name "*.crt" 2>/dev/null | sort | head -n 1
  fi
}

hash_file() {
  local path="$1"
  if [[ -f "$path" ]]; then
    sha256sum "$path" | awk '{print $1}'
  fi
}

print_compose_service_state() {
  local service="$1"
  local state="unknown"

  if state="$("${COMPOSE_CMD[@]}" -f docker-compose.yml ps --status running --services "$service" 2>/dev/null | head -n 1)" && [[ "$state" == "$service" ]]; then
    printf '%s\n' "running"
  else
    printf '%s\n' "not running"
  fi
}

show_certificate_status() {
  ensure_ova_docker
  require_compose_file
  detect_compose
  load_env_file
  cd "$INSTALLER_DIR"

  local relay_cert="${INSTALLER_DIR}/data/relay-certs/fullchain.pem"
  local relay_key="${INSTALLER_DIR}/data/relay-certs/privkey.pem"
  local caddy_cert
  local not_before="-"
  local not_after="-"
  local remaining_days="-"
  local expires_soon="未知"
  local relay_synced="否"

  caddy_cert="$(find_caddy_cert "${RELAY_DOMAIN:-}")"

  if [[ -s "$relay_cert" ]]; then
    not_before="$(openssl x509 -in "$relay_cert" -noout -startdate | cut -d= -f2-)"
    not_after="$(openssl x509 -in "$relay_cert" -noout -enddate | cut -d= -f2-)"
    if end_epoch="$(date -d "$not_after" +%s 2>/dev/null)"; then
      now_epoch="$(date +%s)"
      remaining_days="$(( (end_epoch - now_epoch) / 86400 ))"
    fi
    if openssl x509 -in "$relay_cert" -checkend 2592000 -noout >/dev/null 2>&1; then
      expires_soon="否"
    else
      expires_soon="是"
    fi
  fi

  if [[ -n "$caddy_cert" && -s "$relay_cert" && "$(hash_file "$caddy_cert")" == "$(hash_file "$relay_cert")" ]]; then
    relay_synced="是"
  fi

  cat <<EOF
==================== 证书状态 ====================
Relay 域名：${RELAY_DOMAIN:-未配置}
Relay 证书文件：${relay_cert}
Relay 私钥文件：${relay_key}
Caddy 源证书：${caddy_cert:-未找到}
证书有效期开始：${not_before}
证书有效期结束：${not_after}
剩余天数：${remaining_days}
30 天内是否过期：${expires_soon}

==================== 同步状态 ====================
Caddy 服务：$(print_compose_service_state caddy)
sync-relay-certs 服务：$(print_compose_service_state sync-relay-certs)
relay 服务：$(print_compose_service_state relay)
Caddy 源证书：$(if [[ -n "$caddy_cert" ]]; then printf '已找到'; else printf '未找到'; fi)
Relay 证书：$(if [[ -s "$relay_cert" ]]; then printf '已就绪'; else printf '未就绪'; fi)
Relay 私钥：$(if [[ -s "$relay_key" ]]; then printf '已就绪'; else printf '未就绪'; fi)
Relay 证书已同步：${relay_synced}
EOF
}

print_menu() {
  clear || true
  cat <<'EOF'
=================================================
              NetBird Relay 管理菜单
=================================================
1) 安装或重新配置 Relay
2) 更新镜像并重启服务
3) 查看服务状态
4) 查看服务日志
5) 重启服务
6) 查看证书状态
0) 退出
=================================================
EOF
}

while true; do
  print_menu
  printf '请选择：'
  IFS= read -r choice
  case "$choice" in
    1) run_install ;;
    2) upgrade_images ;;
    3) show_status ;;
    4) show_logs ;;
    5) restart_services ;;
    6) show_certificate_status ;;
    0) exit 0 ;;
    *) echo "无效选择：${choice}" ;;
  esac
  printf '\n按 Enter 继续...'
  IFS= read -r _
done
